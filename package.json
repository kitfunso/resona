{
  "name": "resona",
  "version": "0.0.1",
  "private": true,
  "description": "Every body has a rhythm. Phone-based biosignal screening (breath, heart, motion).",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "test:gpt": "node server/test-gpt.js",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev": "npm-run-all --parallel dev:server dev:client"
  },
  "devDependencies": {
    "npm-run-all": "4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
