# Database
# For local development against the docker-managed test PG, use:
#   DATABASE_URL=postgres://skf_s@127.0.0.1:55432/resona_dev
# Start the container with `scripts/test-db-up.sh`. The user `skf_s` and
# database `resona_dev` match docker-compose.test.yml.
DATABASE_URL=postgres:///resona_dev

# LLM
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Auth
SESSION_SECRET=replace-with-a-random-32-plus-char-string

# Admin bootstrap (rotate on prod, min 32 chars)
ADMIN_TOKEN=replace-with-a-random-32-plus-char-string

# Server
PORT=3030

# LLM tracing (dev only; writes prompts to llm-trace.log)        # added by B12
LLM_TRACE=0

# CORS — comma-separated origins permitted to send credentials   # added by B12
ALLOWED_ORIGINS=http://localhost:5174
