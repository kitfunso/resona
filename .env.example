# Codex (ChatGPT OAuth) — auth is read from ~/.codex/auth.json.
# Log in once with:  npx @openai/codex login
# Optional overrides:
# CODEX_MODEL=gpt-5.4
# CODEX_REASONING=medium         # minimal | low | medium | high | xhigh (narrator overrides to low)
# CODEX_FAST_MODE=true           # priority service tier (lower queue latency)
# CODEX_HOME=C:\Users\you\.codex
PORT=3030
